# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
SUPABASE_SECRET_KEY=your_supabase_service_role_key

# Public site URL (e.g. https://your-site.netlify.app)
NEXT_PUBLIC_SITE_URL=

# Free-tier friendly limits
NEXT_PUBLIC_TOTAL_STORAGE_LIMIT_GB=1
NEXT_PUBLIC_MAX_IMAGES_PER_CAR=8
NEXT_PUBLIC_MAX_CAR_IMAGE_SIZE_MB=5

# Arcjet (optional - bot protection is skipped when ARCJET_KEY is empty)
ARCJET_KEY=
ARCJET_ENV="development"
ARCJET_LOG_LEVEL="error"